y"/></mxCell><mxCell id="n115" value="&lt;span style=&quot;color:#000000;font-size:19px;font-family:Times New Roman;font-weight:bold&quot;&gt;WHEN THE CAR IS NOT DETECTED BY IR SENSOR&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#000000;font-size:16px;font-family:Calibri&quot;&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#00ff00;strokeColor=#003300;strokeWidth=4.0;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="457.3" y="1765.0" width="264.6" height="58.6" as="geometry"/></mxCell><mxCell id="n116" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#ff0000;strokeWidth=6.0;endArrow=classic;startArrow=none;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080.9" y="1823.6" as="sourcePoint"/><mxPoint x="1292.6" y="1823.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n117" value="&lt;span style=&quot;color:#000000;font-size:19px;font-family:Times New Roman;font-weight:bold&quot;&gt;WHEN THE CAR IS DETECTED BY IR SENSOR&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#000000;font-size:16px;font-family:Calibri&quot;&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ff0000;strokeColor=#c00000;strokeWidth=4.0;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="827.7" y="1765.0" width="264.6" height="58.6" as="geometry"/></mxCell><mxCell id="n118" value="" style="ellipse;html=1;fillColor=#00ff00;strokeColor=#003300;strokeWidth=4.0;" vertex="1" parent="1"><mxGeometry x="491.3" y="1839.9" width="200.3" height="177.6" as="geometry"/></mxCell><mxCell id="n119" value="&lt;span style=&quot;color:#000000;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;THE&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#000000;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;INDICATOR &lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#000000;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;SHOWS &lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#000000;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;GREEN&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#000000;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;COLOUR&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="491.3" y="1839.9" width="200.3" height="177.6" as="geometry"/></mxCell><mxCell id="n120" value="" style="ellipse;html=1;fillColor=#ff0000;strokeColor=#000000;strokeWidth=4.0;" vertex="1" parent="1"><mxGeometry x="863.6" y="1836.8" width="200.3" height="177.6" as="geometry"/></mxCell><mxCell id="n121" value="&lt;span style=&quot;color:#000000;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;THE&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#000000;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;INDICATOR &lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#000000;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;SHOWS &lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#000000;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;GREEN&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#000000;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;COLOUR&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="863.6" y="1836.8" width="200.3" height="177.6" as="geometry"/></mxCell><mxCell id="n122" value="" style="ellipse;html=1;fillColor=none;strokeColor=#ffffff;strokeWidth=4.0;" vertex="1" parent="1"><mxGeometry x="514.0" y="1859.5" width="154.5" height="137.0" as="geometry"/></mxCell><mxCell id="n123" value="" style="ellipse;html=1;fillColor=none;strokeColor=#ffffff;strokeWidth=4.0;" vertex="1" parent="1"><mxGeometry x="888.2" y="1854.8" width="154.5" height="137.0" as="geometry"/></mxCell><mxCell id="n124" value="&lt;span style=&quot;color:#003300;font-size:24px;font-family:Times New Roman;font-weight:bold&quot;&gt;THIS TOGGLE SWITCH TURNS ON OR TURNS OFF THE CHARGING&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#0000ff;strokeColor=#000066;strokeWidth=8.0;align=center;verticalAlign=middle;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="566.9" y="2043.0" width="415.7" height="79.2" as="geometry"/></mxCell><mxCell id="n125" value="" style="shape=image;imageAspect=0;image=data:image/jpeg,;strokeColor=#00ff00;strokeWidth=8.0;" vertex="1" parent="1"><mxGeometry x="75.6" y="1689.4" width="302.4" height="445.3" as="geometry"/></mxCell><mxCell id="n126" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#00ffff;strokeWidth=6.0;endArrow=none;startArrow=classic;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="207.9" y="2048.5" as="sourcePoint"/><mxPoint x="567.0" y="2086.3" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n127" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#00ffff;strokeWidth=6.0;endArrow=classic;startArrow=none;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="982.7" y="2086.3" as="sourcePoint"/><mxPoint x="1266.2" y="2067.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n128" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#00ff00;strokeWidth=8.0;endArrow=none;startArrow=classic;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="207.9" y="1765.0" as="sourcePoint"/><mxPoint x="457.3" y="1765.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n129" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#00ff00;strokeWidth=6.0;endArrow=none;startArrow=classic;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="189.0" y="2010.7" as="sourcePoint"/><mxPoint x="491.4" y="1928.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n130" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#ff0000;strokeWidth=6.0;endArrow=classic;startArrow=none;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1063.9" y="1927.7" as="sourcePoint"/><mxPoint x="1273.7" y="2029.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n131" value="&lt;span style=&quot;color:#0099ff;font-size:24px;font-family:Times New Roman;font-weight:bold&quot;&gt;WORKING PROCESS OF PROJECT&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#000022;strokeColor=#000000;strokeWidth=4.0;align=center;verticalAlign=middle;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="75.6" y="941.1" width="510.2" height="75.6" as="geometry"/></mxCell><mxCell id="n132" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#4a206a;strokeWidth=4.0;dashed=1;endArrow=none;startArrow=none;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="48.4" y="1069.6" as="sourcePoint"/><mxPoint x="73.7" y="1069.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n133" value="&lt;span style=&quot;color:#ffffff;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;BATTERY STORAGE WILL GET CHARGED FROM SOLAR PANELS AND WHEN POWER FROM SOLAR PANELS WILL BE INSUFFICIENT IT WILL CHARGE THROUGH GRID.&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#000060;strokeColor=#000060;strokeWidth=4.0;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="73.7" y="1039.4" width="517.8" height="64.3" as="geometry"/></mxCell><mxCell id="n134" value="&lt;span style=&quot;color:#ffffff;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;THE SOLAR CHARGE CONTROLLER REGULATES THE VOLTAGE AND CURRENT COMING FROM SOLAR PANEL AND SAFELY CHARGE BATTERY.&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#000082;strokeColor=#000082;strokeWidth=4.0;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="73.7" y="1126.3" width="517.8" height="64.3" as="geometry"/></mxCell><mxCell id="n135" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#4a206a;strokeWidth=4.0;dashed=1;endArrow=none;startArrow=none;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="48.4" y="1243.5" as="sourcePoint"/><mxPoint x="73.7" y="1243.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n136" value="&lt;span style=&quot;color:#ffffff;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;THE CONTROLLER NODEMCU CONTROLS EVERYTHING THROUGH IOT SYSTEM.&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#0000a8;strokeColor=#0000a8;strokeWidth=4.0;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="73.7" y="1213.2" width="517.8" height="64.3" as="geometry"/></mxCell><mxCell id="n137" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#4a206a;strokeWidth=4.0;dashed=1;endArrow=none;startArrow=none;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="48.4" y="1322.8" as="sourcePoint"/><mxPoint x="73.7" y="1322.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n138" value="&lt;span style=&quot;color:#ffffff;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;THE IR SENSOR HAS WORK OF DETECTING THE CAR.&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#0000e1;strokeColor=#0000e1;strokeWidth=4.0;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="75.6" y="1292.6" width="517.8" height="64.3" as="geometry"/></mxCell><mxCell id="n139" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#4a206a;strokeWidth=4.0;dashed=1;endArrow=none;startArrow=none;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="48.4" y="1413.5" as="sourcePoint"/><mxPoint x="73.7" y="1413.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n140" value="&lt;span style=&quot;color:#ffffff;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;THE DISPLAYS WORK IS TO SHOW WHETHER THE CAR IS DETECTED OR NOT BY DISPLAYING :DETECTED AND NOT DETECTED.&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#5353ff;strokeColor=#5353ff;strokeWidth=4.0;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="75.6" y="1379.5" width="517.8" height="64.3" as="geometry"/></mxCell><mxCell id="n141" value="&lt;span style=&quot;color:#ffffff;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;WHEN CAR GETS IN CHARGING STAND THE OWNER OF STATION WILL TURN ON CHARGING USING TOGGLE SWITCH ON UI AFTER THE PAYMENT AND ALL IS DONE.&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#8484ff;strokeColor=#8484ff;strokeWidth=4.0;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="75.6" y="1462.7" width="517.8" height="64.3" as="geometry"/></mxCell><mxCell id="n142" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#4a206a;strokeWidth=4.0;dashed=1;endArrow=none;startArrow=none;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="48.4" y="1583.6" as="sourcePoint"/><mxPoint x="73.7" y="1583.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n143" value="&lt;span style=&quot;color:#ffffff;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;THE RELAY WORKS TO TURN ON OR TURN OFF THE CHARGING BY CLOSING OR OPENING THE CIRCUIT OF THE TRANSMITTING COIL.&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#b7b7ff;strokeColor=#b7b7ff;strokeWidth=4.0;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="75.6" y="1549.6" width="517.8" height="64.3" as="geometry"/></mxCell><mxCell id="n144" value="" style="rounded=0;html=1;fillColor=#ffd553;strokeColor=#ffc000;strokeWidth=4.0;" vertex="1" parent="1"><mxGeometry x="1196.2" y="1462.7" width="283.5" height="170.1" as="geometry"/></mxCell><mxCell id="n145" value="&lt;span style=&quot;color:#000000;font-size:48px;font-family:Times New Roman;font-weight:bold&quot;&gt;PICTURES OF PROJECT &lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1196.2" y="1446.8" width="283.5" height="201.9" as="geometry"/></mxCell><mxCell id="n146" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#4a206a;strokeWidth=4.0;dashed=1;endArrow=none;startArrow=none;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50.3" y="1492.9" as="sourcePoint"/><mxPoint x="75.6" y="1492.9" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n147" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#4a206a;strokeWidth=4.0;endArrow=none;startArrow=none;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="75.6" y="971.3" as="sourcePoint"/><mxPoint x="48.4" y="1584.7" as="targetPoint"/><Array as="points"><mxPoint x="48.4" y="971.3"/><mxPoint x="48.4" y="1583.6"/></Array></mxGeometry></mxCell><mxCell id="n148" value="" style="htm