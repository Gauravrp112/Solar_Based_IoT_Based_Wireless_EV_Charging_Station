tyle="shape=image;imageAspect=0;image=data:image/jpeg,;rotation=180;" vertex="1" parent="1"><mxGeometry x="317.5" y="525.5" width="75.9" height="120.6" as="geometry"/></mxCell><mxCell id="n86" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#c00000;strokeWidth=4.0;endArrow=none;startArrow=none;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="328.8" y="631.2" as="sourcePoint"/><mxPoint x="487.6" y="740.8" as="targetPoint"/><Array as="points"><mxPoint x="328.8" y="740.8"/></Array></mxGeometry></mxCell><mxCell id="n87" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#000000;strokeWidth=4.0;endArrow=none;startArrow=none;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.5" y="631.2" as="sourcePoint"/><mxPoint x="486.7" y="719.0" as="targetPoint"/><Array as="points"><mxPoint x="385.5" y="719.0"/></Array></mxGeometry></mxCell><mxCell id="n88" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#c00000;strokeWidth=4.0;endArrow=none;startArrow=none;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340.2" y="536.7" as="sourcePoint"/><mxPoint x="425.2" y="396.8" as="targetPoint"/><Array as="points"><mxPoint x="340.2" y="396.8"/></Array></mxGeometry></mxCell><mxCell id="n89" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#00ff00;strokeWidth=2.0;dashed=1;" vertex="1" parent="1"><mxGeometry x="306.1" y="336.4" width="415.7" height="514.0" as="geometry"/></mxCell><mxCell id="n90" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#000000;strokeWidth=4.0;endArrow=none;startArrow=none;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370.4" y="537.5" as="sourcePoint"/><mxPoint x="396.8" y="423.3" as="targetPoint"/><Array as="points"><mxPoint x="370.4" y="423.3"/></Array></mxGeometry></mxCell><mxCell id="n91" value="&lt;span style=&quot;color:#ffc000;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;BATTERY CHARGING MODULE&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#ffc000;strokeWidth=1.0;align=center;verticalAlign=middle;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="434.6" y="548.8" width="105.8" height="63.5" as="geometry"/></mxCell><mxCell id="n92" value="&lt;span style=&quot;color:#ff66ff;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;LITHIUM ION BATTERY&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#ff66ff;strokeWidth=1.0;align=center;verticalAlign=middle;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="442.2" y="359.1" width="128.5" height="34.0" as="geometry"/></mxCell><mxCell id="n93" value="&lt;span style=&quot;color:#00ffff;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;RECEIVING COIL&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=#00ffff;strokeWidth=1.0;align=center;verticalAlign=middle;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="480.0" y="763.5" width="128.5" height="37.8" as="geometry"/></mxCell><mxCell id="n94" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#c00000;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="1360.6" y="430.9" width="130.4" height="30.2" as="geometry"/></mxCell><mxCell id="n95" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#00ff00;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="1137.6" y="771.0" width="94.5" height="22.7" as="geometry"/></mxCell><mxCell id="n96" value="" style="rounded=0;html=1;fillColor=#66ff33;fillOpacity=20;strokeColor=#66ff33;strokeWidth=1.0;dashed=1;" vertex="1" parent="1"><mxGeometry x="315.6" y="347.7" width="396.8" height="491.3" as="geometry"/></mxCell><mxCell id="n97" value="&lt;span style=&quot;color:#0070c0;font-size:24px;font-family:Times New Roman;font-weight:bold&quot;&gt;About project&lt;/span&gt;&lt;span style=&quot;color:#0070c0;font-size:19px;font-family:Times New Roman;font-weight:bold&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color:#ff0000;font-size:19px;font-family:Times New Roman;font-weight:bold&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color:#000000;font-size:19px;font-family:Times New Roman;font-weight:bold&quot;&gt;The project is based on providing autonomous service to futuristic ideas of wireless and autonomous EVs. &lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4.0;dashed=1;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="287.2" y="79.4" width="600.9" height="68.0" as="geometry"/></mxCell><mxCell id="n98" value="&lt;span style=&quot;color:#c00000;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;PROBLEM:&lt;/span&gt;&lt;span style=&quot;color:#000000;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt; How to make Charging of EVs through a standard way as filling petrol or diesel as there are number of different types of charging plugs and sockets in the world in different countries and different manufacturers also have different types of charging plugs and sockets in EVs?&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#00b050;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt;SOLUTION:&lt;/span&gt;&lt;span style=&quot;color:#000000;font-size:16px;font-family:Times New Roman;font-weight:bold&quot;&gt; To use wireless charging system to adjust the power transfer for different vehicles by creating a standard number which will tell us about EVs receiving coil’s range of maximum current rating, Maximum allowable power, Voltage required, etc.So according to it the charging station’s transmitting coil’s output will be adjusted through inverter. &lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ffff66;strokeColor=#000000;strokeWidth=2.0;dashed=1;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="34.0" y="396.8" width="238.1" height="449.8" as="geometry"/></mxCell><mxCell id="n99" value="&lt;span style=&quot;color:#ff0000;font-size:24px;font-family:Times New Roman;font-weight:bold&quot;&gt;Assumptions made for Project:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#ff0066;font-size:19px;font-family:Times New Roman;font-weight:bold&quot;&gt;1. Wireless Charging Technology has became Efficient.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#ff0066;font-size:19px;font-family:Times New Roman;font-weight:bold&quot;&gt;2. Autonomous Vehicles are commonly used as Taxi’s and common use.&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=0;fillColor=#ff99cc;fillOpacity=30;strokeColor=#c00000;strokeWidth=4.0;dashed=1;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="309.9" y="158.7" width="408.2" height="151.2" as="geometry"/></mxCell><mxCell id="n100" value="" style="rounded=0;html=1;fillColor=#3fbefc;fillOpacity=60;strokeColor=#000066;strokeWidth=4.0;" vertex="1" parent="1"><mxGeometry x="26.5" y="910.9" width="578.3" height="740.8" as="geometry"/></mxCell><mxCell id="n101" value="" style="shape=image;imageAspect=0;image=data:image/jpeg,;strokeColor=#ffc000;strokeWidth=4.0;" vertex="1" parent="1"><mxGeometry x="661.4" y="1273.7" width="511.5" height="359.1" as="geometry"/></mxCell><mxCell id="n102" value="" style="html=1;rounded=0;endFill=1;startFill=1;strokeColor=#00ffff;strokeWidth=3.0;dashed=1;endArrow=none;startArrow=none;strokeLinecap=flat;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1067.7" y="1311.5" as="sourcePoint"/><mxPoint x="1115.0" y="933.5" as="targetPoint"/><Array as="points"><mxPoint x="1077.9" y="1311.5"/></